{
  "name": "nguyen-duc-loc",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "node src/build.ts",
    "refresh": "node src/refresh.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check",
    "lint:md": "markdownlint-cli2",
    "prepare": "simple-git-hooks"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/node": "^26.6.6",
    "markdownlint-cli2": "^0.24.1",
    "simple-git-hooks": "^2.14.0",
    "typescript": "^7.0.2"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec biome check --staged --no-errors-on-unmatched && pnpm typecheck"
  }
}
